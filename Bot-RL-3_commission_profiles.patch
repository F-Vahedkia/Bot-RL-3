@@ -0,0 +1,102 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from f03_data.instrument_specs import InstrumentSpec
+from f05_transact_costs.contracts import CommissionModel, CostSource, MarketQuote
+from f06_env.contracts import PositionIntent
+from f06_env.execution_simulator import ExecutionCost, ExecutionSimulator
+from f06_env.portfolio_state import PositionState
+
+
+TS = datetime(2026, 10, 1, tzinfo=timezone.utc)
+
+
+def instrument() -> InstrumentSpec:
+    return InstrumentSpec(
+        "EURUSD",
+        0.0001,
+        0.00001,
+        1.0,
+        "USD",
+        contract_size=100000.0,
+        currency_base="EUR",
+        currency_profit="USD",
+        account_currency="USD",
+    )
+
+
+def quote() -> MarketQuote:
+    return MarketQuote(
+        "EURUSD", 1.10000, 1.10010, TS, CostSource.SIMULATION
+    )
+
+
+def open_position(*, cost: ExecutionCost, lots: float = 2.0):
+    position = PositionState(symbol="EURUSD")
+    result = ExecutionSimulator().execute(
+        position=position,
+        intent=PositionIntent("EURUSD", target_side=1, target_lots=lots),
+        quote=quote(),
+        instrument=instrument(),
+        cost=cost,
+    )
+    return position, result
+
+
+def test_per_lot_commission_scales_with_executed_volume() -> None:
+    cost = ExecutionCost(
+        commission_model=CommissionModel("per_lot", 3.5, "USD"),
+        account_currency="USD",
+    )
+    _, result = open_position(cost=cost, lots=2.0)
+    assert result["commission"] == pytest.approx(7.0)
+    assert result["accounting_realized_delta"] == pytest.approx(-7.0)
+
+
+def test_percent_notional_uses_fill_price_contract_size_and_lots() -> None:
+    cost = ExecutionCost(
+        commission_model=CommissionModel("percent_notional", 0.0001, "USD"),
+        commission_notional_basis="quote",
+        account_currency="USD",
+    )
+    _, result = open_position(cost=cost, lots=2.0)
+    expected_notional = 1.10010 * 100000.0 * 2.0
+    assert result["commission"] == pytest.approx(expected_notional * 0.0001)
+
+
+def test_percent_notional_refuses_unknown_currency_conversion() -> None:
+    cost = ExecutionCost(
+        commission_model=CommissionModel("percent_notional", 0.0001, "EUR"),
+        commission_notional_basis="quote",
+        account_currency="USD",
+    )
+    with pytest.raises(ValueError, match="notional_to_commission_rate"):
+        open_position(cost=cost, lots=1.0)
+
+
+def test_commission_currency_to_account_currency_conversion_is_required() -> None:
+    cost = ExecutionCost(
+        commission_model=CommissionModel("per_lot", 3.5, "EUR"),
+        account_currency="USD",
+    )
+    with pytest.raises(ValueError, match="commission_to_account_rate"):
+        open_position(cost=cost, lots=1.0)
+
+
+def test_timestamp_aware_conversion_resolver_is_used() -> None:
+    observed: list[datetime] = []
+
+    def eur_to_usd(timestamp: datetime) -> float:
+        observed.append(timestamp)
+        return 1.2
+
+    cost = ExecutionCost(
+        commission_model=CommissionModel("per_lot", 3.5, "EUR"),
+        account_currency="USD",
+        commission_to_account_rate=eur_to_usd,
+    )
+    _, result = open_position(cost=cost, lots=2.0)
+    assert result["commission"] == pytest.approx(8.4)
+    assert observed == [TS]
+
*** End Patch
