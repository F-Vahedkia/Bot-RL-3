@@ -0,0 +1,75 @@
+import pytest
+
+from .commission_profiles import CommissionProfileCatalog
+from .contracts import CommissionModel
+
+
+def fallback_model() -> CommissionModel:
+    return CommissionModel("per_lot", 7.0, "USD")
+
+
+def test_resolves_symbol_override_and_round_turn_basis() -> None:
+    catalog = CommissionProfileCatalog.from_mapping(
+        {
+            "active_broker": "demo",
+            "active_account_type": "raw",
+            "brokers": {
+                "demo": {
+                    "accounts": {
+                        "raw": {
+                            "strict_symbols": True,
+                            "symbols": {
+                                "EURUSD": {
+                                    "basis": "per_lot",
+                                    "rate": 7.0,
+                                    "currency": "USD",
+                                    "minimum": 0.0,
+                                    "billing_basis": "round_turn",
+                                    "notional_basis": "base",
+                                    "verified": True,
+                                }
+                            },
+                        }
+                    }
+                }
+            },
+        },
+        fallback_model=fallback_model(),
+    )
+
+    profile = catalog.resolve(symbol="eurusd")
+    assert profile.model.amount(lots=2.0, notional=0.0) == 14.0
+    assert profile.amount_multiplier == 0.5
+    assert profile.per_side_model.amount(lots=2.0, notional=0.0) == 7.0
+    assert profile.verified is True
+
+    with pytest.raises(KeyError, match="strict_symbols=true"):
+        catalog.resolve(symbol="GBPUSD")
+
+
+def test_default_selector_preserves_existing_global_schedule() -> None:
+    catalog = CommissionProfileCatalog.from_mapping(
+        {"active_broker": "default", "active_account_type": "default"},
+        fallback_model=fallback_model(),
+    )
+    profile = catalog.resolve(symbol="EURUSD")
+    assert profile.key == "legacy_default"
+    assert profile.model.amount(lots=0.5, notional=0.0) == 3.5
+    assert profile.verified is False
+
+
+def test_round_turn_profile_rejects_minimum_until_partial_fill_ledger_exists() -> None:
+    with pytest.raises(ValueError, match="round_turn profiles require minimum=0"):
+        CommissionProfileCatalog.from_mapping(
+            {
+                "default": {
+                    "basis": "per_lot",
+                    "rate": 7.0,
+                    "currency": "USD",
+                    "minimum": 2.0,
+                    "billing_basis": "round_turn",
+                }
+            },
+            fallback_model=fallback_model(),
+        )
+
*** End Patch
